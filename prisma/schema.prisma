// prisma/schema.prisma — Prism · Sam Farma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Unidade de negócio (loja / filial). Toda transação pode ser filtrada por unidade.
model Unit {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  bankAccounts BankAccount[]
  transactions Transaction[]
  sales        UnitSales[]
}

/// Conta bancária / caixa de uma unidade.
model BankAccount {
  id             Int           @id @default(autoincrement())
  name           String
  unitId         Int
  unit           Unit          @relation(fields: [unitId], references: [id])
  initialBalance Float         @default(0)
  transactions   Transaction[]
}

/// Plano de contas. `dreGroup` define a posição da conta na DRE (ver src/lib/dre.ts).
/// type: RECEITA | DEDUCAO | CUSTO | DESPESA | IMPOSTO | NEUTRO
model Account {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  /// Caminho completo do "Plano de Contas" no ERP — chave do De-Para
  erpKey       String?       @unique
  type         String
  dreGroup     String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

/// Lançamento financeiro. Modelo central: alimenta a DRE e o Dashboard.
/// `amount` negativo = saída/despesa · positivo = entrada/receita.
/// `month`/`year` = competência contábil (pode diferir de `date`).
/// `accountId` null = não classificado → fora da DRE.
model Transaction {
  id                      Int          @id @default(autoincrement())
  date                    DateTime
  description             String
  amount                  Float
  memo                    String?
  fitid                   String?      @unique
  accountId               Int?
  account                 Account?     @relation(fields: [accountId], references: [id])
  unitId                  Int?
  unit                    Unit?        @relation(fields: [unitId], references: [id])
  bankAccountId           Int?
  bankAccount             BankAccount? @relation(fields: [bankAccountId], references: [id])
  transferToUnitId        Int?
  transferToBankAccountId Int?
  /// REALIZADO (entra na DRE) | PENDENTE (entra no fluxo projetado)
  status                  String       @default("REALIZADO")
  /// Vencimento — competência do fluxo de caixa projetado
  dueDate                 DateTime?
  month                   Int
  year                    Int
  createdAt               DateTime     @default(now())

  @@index([month, year])
}

/// Faturamento e CMV por loja/mês (aba Base_Vendas do arquivo da DRE).
/// Só serve de base de rateio: os recebimentos chegam consolidados, sem unidade,
/// então a receita de cada loja é a receita total do mês × participação da loja
/// no faturamento — a mesma regra da planilha do cliente.
model UnitSales {
  id           Int      @id @default(autoincrement())
  unitId       Int
  unit         Unit     @relation(fields: [unitId], references: [id])
  month        Int
  year         Int
  faturamento  Float    @default(0)
  cmv          Float    @default(0)
  createdAt    DateTime @default(now())

  @@unique([unitId, month, year])
  @@index([month, year])
}
